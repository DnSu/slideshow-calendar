# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables. Never commit real values.

# ID of the public Google Drive folder (the part after /folders/ in its share link).
DRIVE_FOLDER_ID=your-drive-folder-id

# ID of the public Google Calendar (Calendar settings -> Integrate calendar).
CALENDAR_ID=your-calendar-id@group.calendar.google.com

# IANA timezone used for folder dates and event times. Optional, defaults to UTC.
TIMEZONE=America/New_York

# Weather (optional; leave both location options empty for no weather slide).
# Simplest: a ZIP / postal code, looked up once with Open-Meteo's free geocoding.
WEATHER_ZIP=00000
# 2-letter country code for the ZIP. Optional, defaults to US.
WEATHER_COUNTRY=US
# More exact: coordinates. If both are set they are used instead of the ZIP.
# WEATHER_LATITUDE=0.0000
# WEATHER_LONGITUDE=0.0000
